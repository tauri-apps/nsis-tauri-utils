{
  "gitSiteUrl": "https://www.github.com/tauri-apps/nsis-tauri-utils/",
  "timeout": 3600000,
  "pkgManagers": {
    "rust": {
      "version": true,
      "getPublishedVersion": "node ../../.scripts/package-latest-version.js ${ pkgFile.name } ${ pkgFile.version }",
      "publish": [
        {
          "command": "cargo build --release --target i686-pc-windows-msvc",
          "dryRunCommand": true
        },
        {
          "command": "cargo build --release --target x86_64-pc-windows-msvc",
          "dryRunCommand": true
        },
        {
          "command": "cargo build --release --target i686-pc-windows-msvc --features ansi --target-dir ../../target/x86-ansi",
          "dryRunCommand": true
        },
        {
          "command": "pwsh -NoProfile -File ../../.scripts/package-plugin.ps1 ${ pkg.pkg }",
          "dryRunCommand": true,
          "pipe": true
        }
      ],
      "postpublish": [
        "git tag ${ pkg.pkg }-v${ pkgFile.versionMajor } -f",
        "git tag ${ pkg.pkg }-v${ pkgFile.versionMajor }.${ pkgFile.versionMinor } -f",
        "git push --tags -f"
      ]
    }
  },
  "packages": {
    "nsis_tauri_utils": {
      "path": "./crates/nsis-tauri-utils",
      "manager": "rust",
      "assets": [
        {
          "path": "target/packages/${ pkg.pkg }.zip",
          "name": "${ pkg.pkg }.zip"
        }
      ]
    },
    "nsis_process": {
      "path": "./crates/nsis-process",
      "manager": "rust",
      "assets": [
        {
          "path": "target/packages/${ pkg.pkg }.zip",
          "name": "${ pkg.pkg }.zip"
        }
      ]
    },
    "nsis_semvercompare": {
      "path": "./crates/nsis-semvercompare",
      "manager": "rust",
      "assets": [
        {
          "path": "target/packages/${ pkg.pkg }.zip",
          "name": "${ pkg.pkg }.zip"
        }
      ]
    },
    "nsis_string": {
      "path": "./crates/nsis-string",
      "manager": "rust",
      "assets": [
        {
          "path": "target/packages/${ pkg.pkg }.zip",
          "name": "${ pkg.pkg }.zip"
        }
      ]
    }
  }
}
